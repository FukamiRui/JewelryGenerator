# Supabase — server-side (service role bypasses RLS, keep secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — client-side (safe to expose, used by the browser for auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API — no longer required (prompts are now built directly from
# each material's ai_prompt_tag, no LLM call). Safe to leave blank.
ANTHROPIC_API_KEY=

# FLUX.1 [pro] via fal.ai (image gen) — same key is reused for video gen
FAL_API_KEY=

# Optional — overrides the fal.ai image-to-video model used for portfolio
# video posts. Defaults to fal-ai/kling-video/v2.1/standard/image-to-video.
# Every fal.ai image-to-video model shares the same {prompt, image_url}
# request shape, so swapping models (Seedance, Veo, PixVerse, …) is just
# changing this URL.
FAL_VIDEO_MODEL_ENDPOINT=

# Ideogram (engraving text branch — not yet wired to the UI)
IDEOGRAM_API_KEY=

# Gold API (goldapi.io) — precious metal spot prices
GOLD_API_KEY=

# Shared secret so only your cron scheduler can hit /api/gold-rate/refresh
# and /api/cron/reset-credits
CRON_SECRET=

# Stripe Connect (Express) — shop payouts and platform commission
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used by the public share page (server component) to call the API
NEXT_PUBLIC_SITE_URL=http://localhost:3000
